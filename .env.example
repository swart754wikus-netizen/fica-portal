# 32-byte base64 key used to encrypt client PII and documents at rest (AES-256-GCM).
# Generate with: npm run gen-key   — in production, load from a KMS / secrets manager, never commit.
DATA_KEY=
PORT=3000
# Public base URL used in client invite links
BASE_URL=http://localhost:3000
DB_PATH=./data/fica.db
# Storage backend: "sqlite" (local file, default outside Vercel) or "firestore" (production; default on Vercel)
STORE=sqlite
# One-time code for /staff/setup (creates the first compliance officer from the browser)
SETUP_TOKEN=
# Firebase (production) — from Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Set to "production" behind HTTPS so cookies are Secure
NODE_ENV=development
# Screening provider adapter: "mock" until a bureau is contracted
SCREENING_PROVIDER=mock
INVITE_TTL_HOURS=72

# Shown in emails and the client form
FIRM_NAME=Example Attorneys Inc.
# Email: "log" (dev — prints to console, link shown on screen) or "smtp" (production)
MAIL_TRANSPORT=log
# SMTP relay, e.g. Microsoft 365: smtp.office365.com / 587. Use an app password or relay credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a mailbox/domain your SMTP account may send as (set up SPF, DKIM and DMARC for it)
MAIL_FROM="Example Attorneys <compliance@example.co.za>"
