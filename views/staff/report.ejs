<!doctype html>
<html lang="en-ZA"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
<title>KYC report <%= c.reference %> · <%= firmName %></title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@600;700&family=Roboto:wght@400;700&display=swap"><link rel="stylesheet" href="/static/report.css"><script src="/static/app.js" defer></script></head>
<body>
<div class="toolbar no-print"><button data-print>Print / Save as PDF</button></div>
<header>
  <% if (locals.logoOnLight) { %><img class="logo" src="<%= logoOnLight %>" alt="<%= firmName %>"><% } else { %><p class="firm"><%= firmName %></p><% } %>
  <h1>Know your customer report</h1>
  <p><strong><%= c.reference %></strong> · Generated <%= fmtDateTime(generatedAt) %> by <%= generatedBy.name %></p>
  <p class="conf">Confidential — contains personal information protected under POPIA</p>
</header>
<section><h2>1. Client</h2>
<table>
  <tr><th>Client type</th><td><%= CLIENT_TYPES[data.clientType]?.label || '—' %></td></tr>
  <tr><th>Services</th><td><%= (data.services || []).map((x) => SERVICES[x] || x).join(', ') %></td></tr>
<% if (data.entity) { const e = data.entity; %>
  <tr><th>Registered name</th><td><%= e.name %> (<%= ENTITY_SUBTYPES[data.clientType]?.[e.subtype] || e.subtype %>)</td></tr>
  <tr><th>Registration no. / tax no.</th><td><%= e.regNumber %> / <%= e.taxNumber || '—' %></td></tr>
  <tr><th>Registered address</th><td><%= e.address %></td></tr>
  <tr><th>Nature of business</th><td><%= e.natureOfBusiness %></td></tr>
  <tr><th>Outside SA / cash-intensive</th><td><%= e.countriesOfOperation || 'No' %> / <%= e.cashIntensive ? 'Yes' : 'No' %></td></tr>
</table>
<h3>Owners, directors &amp; controllers</h3>
<table><tr><th>Name</th><th>ID / passport</th><th>Role</th><th>%</th><th>Nationality</th><th>PEP</th></tr>
<% for (const p of data.related || []) { %><tr><td><%= p.name %><%= p.isEntity ? ' (entity)' : '' %></td><td><%= p.idNumber || '—' %></td><td><%= ROLES[data.clientType]?.[p.role] || p.role %></td><td><%= p.ownership || '' %></td><td><%= p.nationality %></td><td><%= p.pep ? 'Yes' : 'No' %></td></tr><% } %>
</table>
<h3>Person completing the form (<%= e.capacity %>)</h3>
<table>
<% } %>
  <tr><th>Name</th><td><%= data.firstName %> <%= data.lastName %></td></tr>
  <tr><th><%= data.idType === 'sa_id' ? 'SA ID' : 'Passport' %></th><td><%= data.idNumber %></td></tr>
  <tr><th>Date of birth</th><td><%= fmtDate(data.dateOfBirth) %></td></tr>
  <tr><th>Nationality / residence</th><td><%= data.nationality %> / <%= data.countryOfResidence %></td></tr>
  <tr><th>Address</th><td><%= [data.addressLine1, data.addressLine2, data.city, data.province, data.postalCode].filter(Boolean).join(', ') %></td></tr>
  <tr><th>Tax no.</th><td><%= data.taxNumber || '—' %></td></tr>
  <tr><th>Occupation</th><td><%= data.occupation %><%= data.employer ? ' — ' + data.employer : '' %></td></tr>
  <tr><th>Source of funds</th><td><%= data.sourceOfFunds.replace(/_/g, ' ') %></td></tr>
  <tr><th>Purpose of relationship</th><td><%= data.purpose %></td></tr>
  <tr><th>PEP self-declaration</th><td><%= data.pepDeclared ? 'Yes — ' + data.pepDetails : 'No' %></td></tr>
</table></section>
<section><h2>2. Screening (<%= screening.provider %>, ref <%= screening.reference %>, <%= fmtDateTime(screening.checkedAt) %>)</h2>
<table>
  <tr><th>Identity</th><td><%= screening.identity.verified ? 'Verified' : 'NOT verified' %></td></tr>
  <tr><th>Address</th><td><%= screening.address.verified ? 'Verified' : 'NOT verified' %></td></tr>
  <tr><th>Sanctions</th><td><%= screening.sanctions.match ? 'MATCH — ' + screening.sanctions.detail : 'No match' %></td></tr>
  <tr><th>PEP</th><td><%= screening.pep.match ? 'MATCH — ' + screening.pep.detail : 'No match' %></td></tr>
  <tr><th>Adverse media</th><td><%= screening.adverseMedia.match ? 'HIT — ' + screening.adverseMedia.detail : 'None found' %></td></tr>
</table>
<% if ((screening.related || []).length) { %>
<h3>Owners, directors &amp; controllers screened</h3>
<table><tr><th>Name</th><th>Sanctions</th><th>PEP</th><th>Adverse media</th></tr>
<% for (const r of screening.related) { %><tr><td><%= r.name %></td><td><%= r.sanctions?.match ? 'MATCH' : 'No match' %></td><td><%= r.pep?.match ? 'MATCH' : 'No match' %></td><td><%= r.adverseMedia?.match ? 'HIT' : 'None' %></td></tr><% } %>
</table>
<% } %>
</section>
<section><h2>3. Risk assessment (RMCP v<%= risk.rmcpVersion %>)</h2>
<p><strong>Score <%= risk.score %> — <%= risk.level[0].toUpperCase() + risk.level.slice(1) %> risk — <%= risk.ddLevel %></strong> (<%= risk.ddLabel %>)</p>
<table><tr><th>Factor</th><th>Detail</th><th>Points</th></tr>
<% for (const f of risk.factors) { %><tr><td><%= f.factor %></td><td><%= String(f.note || '').replace(/_/g, ' ') %></td><td>+<%= f.points %></td></tr><% } %></table></section>
<section><h2>4. Documents on file</h2>
<table><tr><th>Document</th><th>Type</th><th>SHA-256</th></tr>
<% for (const d of docs) { %><tr><td><%= DOC_LABELS[d.kind] %></td><td><%= d.mime %></td><td class="mono"><%= d.sha256 %></td></tr><% } %></table></section>
<section><h2>5. Decision</h2>
<% if (decidedBy) { %>
<p><strong><%= c.status[0].toUpperCase() + c.status.slice(1) %></strong> by <%= decidedBy.name %> (<%= decidedBy.role %>) on <%= fmtDateTime(c.decided_at) %></p>
<p><%= c.decision_reason %></p>
<p>Records retained until <%= fmtDate(c.retention_until) %> (FICA s22–s23).</p>
<% } else { %><p>Pending review.</p><% } %>
<p>POPIA consent captured <%= fmtDateTime(data.consent.at) %>.</p>
</section>
<footer>Powered by <a href="https://gls-technologies.co.za/">GLS Technologies</a></footer>
</body></html>
