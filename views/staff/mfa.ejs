<%- include('../partials/head', { title: 'Two-step verification' }) %>
<form method="post" action="/staff/mfa" class="card narrow form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (locals.enroll) { %>
    <h1>Set up two-step verification</h1>
    <p class="muted small">Required for access to client FICA records. Install <strong>Google Authenticator</strong> or <strong>Microsoft Authenticator</strong> on your phone, then:</p>
    <ol class="small enroll-steps">
      <li>In the app tap <strong>+</strong> → <strong>Scan a QR code</strong> and point your phone at this code:</li>
    </ol>
    <% if (locals.qr) { %><img class="enroll-qr" src="<%= qr %>" alt="QR code to add this account to your authenticator app" width="220" height="220"><% } %>
    <ol class="small enroll-steps" start="2">
      <li>Type the 6-digit code the app shows, below.</li>
    </ol>
    <details class="small"><summary>Can't scan? Enter the key by hand</summary>
      <p>In the app choose <strong>Enter a setup key</strong> and type: <code class="setup-key"><%= secret %></code></p>
      <p><a href="<%= uri %>">Or tap here if you're on your phone</a></p>
    </details>
    <p class="small muted">Keep this screen private — don't screenshot or share the code.</p>
  <% } else { %>
    <h1>Enter your 6-digit code</h1>
    <p class="muted small">Open your authenticator app.</p>
  <% } %>
  <% if (error) { %><div class="callout error" role="alert"><%= error %></div><% } %>
  <label>Code<input name="code" inputmode="numeric" pattern="\d{6}" maxlength="6" autocomplete="one-time-code" required autofocus class="otp"></label>
  <button class="btn primary block">Verify</button>
</form>
<%- include('../partials/foot') %>
