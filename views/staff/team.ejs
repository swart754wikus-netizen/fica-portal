<%- include('../partials/head', { title: 'Team' }) %>
<div class="page-head"><h1>Team</h1></div>
<% const roleLabel = { officer: 'Officer', compliance: 'Compliance officer', admin: 'Administrator' }; %>
<div class="card table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% for (const s of staffList) { const active = s.active !== false && s.active !== 0; const pending = Boolean(s.pending_approval); const a = s.actions || []; const mine = String(s.id) === staff.id; %>
      <tr>
        <td><%= s.name %></td><td><%= s.email %></td><td><%= roleLabel[s.role] || s.role %></td>
        <td><span class="pill <%= pending ? 'status-submitted' : active ? 'ok' : 'bad' %>"><%= pending ? 'awaiting approval' : !active ? 'deactivated' : s.totp_secret_enc ? 'active' : 'awaiting first login' %></span></td>
        <td class="row-actions">
          <% if (a.includes('approve') && pending) { %>
            <form method="post" action="/staff/team/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn primary" name="action" value="approve">Approve</button></form>
          <% } %>
          <% if (!mine && !pending && a.includes(active ? 'deactivate' : 'activate')) { %>
            <form method="post" action="/staff/team/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn" name="action" value="<%= active ? 'deactivate' : 'activate' %>"><%= active ? 'Deactivate' : 'Reactivate' %></button></form>
          <% } else if (!mine && pending && a.includes('deactivate') && !a.includes('approve')) { %>
            <span class="small muted">A compliance officer must approve</span>
          <% } %>
          <% if (!mine && a.includes('tempPassword')) { %>
            <form method="post" action="/staff/team/<%= s.id %>" class="temp-pw"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="action" value="tempPassword"><input name="password" placeholder="New temporary password" minlength="12" required aria-label="New temporary password for <%= s.name %>" data-pw-target><button type="button" class="btn" data-generate-pw>Generate</button><button class="btn">Set</button></form>
          <% } %>
          <% if (a.includes('resetMfa')) { %>
            <form method="post" action="/staff/team/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn" name="action" value="resetMfa" data-confirm="Reset two-step verification? They will scan a new QR code at next login.">Reset 2-step</button></form>
          <% } %>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<form method="post" action="/staff/team" class="card form" style="max-width:none">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>Add a staff member</h2>
  <p class="small muted">They log in at <strong>/staff/login</strong> with this temporary password, set up two-step verification, and must then choose their own password. Give them the temporary password in person or by phone — not by email.<% if (!isCompliance) { %> Officers you add can only log in once a compliance officer has approved them.<% } %></p>
  <% if (error) { %><div class="callout error" role="alert"><%= error %></div><% } %>
  <div class="grid2">
    <label>Full name<input name="name" value="<%= values.name || '' %>" required></label>
    <label>Email<input type="email" name="email" value="<%= values.email || '' %>" required></label>
  </div>
  <div class="grid2">
    <label>Role
      <select name="role">
        <option value="admin" <%= values.role === 'admin' ? 'selected' : '' %>>Administrator — sends FICA invites, tracks progress, adds staff (no client documents)</option>
        <option value="officer" <%= values.role === 'officer' ? 'selected' : '' %>>Officer — reviews clients and documents, approves low/medium risk<%= isCompliance ? '' : ' (needs compliance approval)' %></option>
        <% if (isCompliance) { %><option value="compliance" <%= values.role === 'compliance' ? 'selected' : '' %>>Compliance officer — approves high risk, manages everyone, audit log</option><% } %>
      </select>
    </label>
    <label>Temporary password <span class="muted small">(12+ characters)</span>
      <span class="pw-row"><input name="password" type="text" autocomplete="off" required minlength="12" data-pw-target><button type="button" class="btn" data-generate-pw>Generate</button></span>
    </label>
  </div>
  <div class="actions"><button class="btn primary">Add staff member</button></div>
</form>
<%- include('../partials/foot') %>
