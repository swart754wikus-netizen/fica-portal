<%- include('../partials/head', { title: 'Change password' }) %>
<form method="post" action="/staff/password" class="card narrow form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h1><%= forced ? 'Choose your own password' : 'Change password' %></h1>
  <% if (forced) { %><p class="muted small">You signed in with a temporary password. Choose a new one that only you know — at least 12 characters. A short sentence works well.</p><% } %>
  <% if (error) { %><div class="callout error" role="alert"><%= error %></div><% } %>
  <label><%= forced ? 'Temporary password' : 'Current password' %><input type="password" name="currentPassword" autocomplete="current-password" required></label>
  <label>New password<input type="password" name="newPassword" autocomplete="new-password" minlength="12" required></label>
  <label>Repeat new password<input type="password" name="confirmPassword" autocomplete="new-password" minlength="12" required></label>
  <button class="btn primary block">Save password</button>
  <% if (!forced) { %><p class="small center"><a href="/staff">Cancel</a></p><% } %>
</form>
<%- include('../partials/foot') %>
