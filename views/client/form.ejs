<%
  const v = values || {};
  const err = (k) => errors[k] ? `<p class="field-error" id="${k}-err">${errors[k]}</p>` : '';
  const aria = (k) => errors[k] ? `aria-invalid="true" aria-describedby="${k}-err"` : '';
  const countries = [['ZA','South Africa'],['BW','Botswana'],['LS','Lesotho'],['MZ','Mozambique'],['NA','Namibia'],['SZ','Eswatini'],['ZW','Zimbabwe'],['ZM','Zambia'],['MW','Malawi'],['AO','Angola'],['NG','Nigeria'],['KE','Kenya'],['GH','Ghana'],['CD','DR Congo'],['GB','United Kingdom'],['US','United States'],['DE','Germany'],['NL','Netherlands'],['PT','Portugal'],['FR','France'],['IN','India'],['CN','China'],['AE','United Arab Emirates'],['AU','Australia'],['IR','Iran'],['KP','North Korea'],['MM','Myanmar'],['XX','Other']];
  const sel = (name) => countries.map(([c,n]) => `<option value="${c}" ${v[name]===c?'selected':''}>${n}</option>`).join('');
  const sourceLabels = { salary:'Salary / employment', pension:'Pension / annuity', business_income:'Business income', investments:'Investments / dividends', inheritance:'Inheritance', sale_of_property:'Sale of property or assets', cryptocurrency:'Cryptocurrency', other:'Other' };
  const t = v.clientType || '';
  const checkedServices = Array.isArray(v.services) ? v.services : v.services ? [v.services] : [];
  const rel = (Array.isArray(v.related) ? v.related : v.related && typeof v.related === 'object' ? Object.values(v.related) : []);
  const relRows = Math.max(3, rel.length);
  const showFor = (...types) => `data-for="${types.join(' ')}"` + (t && !types.includes(t) ? ' hidden' : '');
  const fileInput = (name) => `<input type="file" name="${name}" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"${DOCUMENTS[name].multiple ? ' multiple' : ''} ${aria(name)}>`;
  const docTypes = (name) => Object.entries(REQUIRED_DOCUMENTS).filter(([, d]) => d.required.includes(name) || d.optional.includes(name)).map(([k]) => k);
  const optionalFor = (name) => Object.entries(REQUIRED_DOCUMENTS).filter(([, d]) => d.optional.includes(name)).map(([k]) => k);
%>
<%- include('../partials/head', { title: 'Client verification' }) %>
<div class="form-head">
  <p class="eyebrow">Reference <%= c.reference %></p>
  <h1>Hi <%= c.client_name.split(' ')[0] %>, let's verify your identity</h1>
  <p class="muted"><%= firmName %> is required by the Financial Intelligence Centre Act (FICA) to verify every client. Takes 5–15 minutes. Have your ID, a proof of address (less than 3 months old) and, for a company or trust, its registration documents ready.</p>
</div>

<% if (Object.keys(errors).length) { %>
  <div class="callout error" role="alert" tabindex="-1" data-focus><strong>Please fix the highlighted fields.</strong><% if (errors.form) { %> <%= errors.form %><% } %></div>
<% } %>

<form method="post" enctype="multipart/form-data" class="card form" novalidate>
  <fieldset>
    <legend><span class="step-num">1</span> Who is this application for?</legend>
    <div class="type-grid" role="radiogroup" <%- aria('clientType') %>>
      <% for (const [key, ct] of Object.entries(CLIENT_TYPES)) { %>
        <label class="type-option"><input type="radio" name="clientType" value="<%= key %>" <%= t === key ? 'checked' : '' %> data-client-type> <span><strong><%= ct.label %></strong><small><%= ct.hint %></small></span></label>
      <% } %>
    </div><%- err('clientType') %>
    <p class="small muted">Which services do you need from us?</p>
    <div class="check-grid" <%- aria('services') %>>
      <% for (const [key, label] of Object.entries(SERVICES)) { %>
        <label class="check"><input type="checkbox" name="services" value="<%= key %>" <%= checkedServices.includes(key) ? 'checked' : '' %>> <span><%= label %></span></label>
      <% } %>
    </div><%- err('services') %>
  </fieldset>

  <fieldset <%- showFor('company', 'trust', 'partnership') %>>
    <legend><span class="step-num">2</span> <span data-entity-title>Entity details</span></legend>
    <div class="grid2">
      <label>Registered name<input name="entityName" value="<%= v.entityName || '' %>" <%- aria('entity.name') %>><%- err('entity.name') %></label>
      <label>Type
        <select name="entitySubtype" <%- aria('entity.subtype') %>>
          <option value="">Select…</option>
          <% for (const [ct, subs] of Object.entries(ENTITY_SUBTYPES)) { for (const [k, label] of Object.entries(subs)) { %>
            <option value="<%= k %>" data-for="<%= ct %>" <%= v.entitySubtype === k && t === ct ? 'selected' : '' %>><%= label %></option>
          <% } } %>
        </select><%- err('entity.subtype') %>
      </label>
    </div>
    <div class="grid2">
      <label>Registration number <span class="muted small">(CIPC no., Master's reference IT…, or partnership no.)</span><input name="entityRegNumber" value="<%= v.entityRegNumber || '' %>" <%- aria('entity.regNumber') %>><%- err('entity.regNumber') %></label>
      <label>SARS income tax number <span class="muted">(if registered)</span><input name="entityTaxNumber" value="<%= v.entityTaxNumber || '' %>" inputmode="numeric" <%- aria('entity.taxNumber') %>><%- err('entity.taxNumber') %></label>
    </div>
    <label>Registered address<textarea name="entityAddress" rows="2" <%- aria('entity.address') %>><%= v.entityAddress || '' %></textarea><%- err('entity.address') %></label>
    <label>Nature of business / main activities<textarea name="natureOfBusiness" rows="2" <%- aria('entity.natureOfBusiness') %>><%= v.natureOfBusiness || '' %></textarea><%- err('entity.natureOfBusiness') %></label>
    <label>Countries it operates in outside South Africa <span class="muted">(leave blank if none)</span><input name="countriesOfOperation" value="<%= v.countriesOfOperation || '' %>"></label>
    <p class="small muted">Does the business mainly receive or pay out cash?</p>
    <div class="radio-row" <%- aria('entity.cashIntensive') %>>
      <label class="radio"><input type="radio" name="cashIntensive" value="no" <%= v.cashIntensive === 'no' ? 'checked' : '' %>> No</label>
      <label class="radio"><input type="radio" name="cashIntensive" value="yes" <%= v.cashIntensive === 'yes' ? 'checked' : '' %>> Yes</label>
    </div><%- err('entity.cashIntensive') %>
    <label>Your capacity <span class="muted small">(e.g. director, trustee, partner, authorised person)</span><input name="capacity" value="<%= v.capacity || '' %>" <%- aria('entity.capacity') %>><%- err('entity.capacity') %></label>
  </fieldset>

  <fieldset <%- showFor('company', 'trust', 'partnership') %>>
    <legend><span class="step-num">3</span> Owners, directors &amp; controllers</legend>
    <% for (const [ct, text] of Object.entries(RELATED_HELP)) { %><p class="small muted" data-for="<%= ct %>" <%= t && t !== ct ? 'hidden' : '' %>><%= text %></p><% } %>
    <% if (errors.related) { %><p class="field-error" role="alert"><%= errors.related %></p><% } %>
    <div id="related-rows">
      <% for (let i = 0; i < relRows; i++) { const r = rel[i] || {}; %>
        <div class="related-row" data-related-row>
          <div class="grid3">
            <label>Full name<input name="related[<%= i %>][name]" value="<%= r.name || '' %>" <%- aria(`related.${i}.name`) %>><%- err(`related.${i}.name`) %></label>
            <label>ID / passport no.<input name="related[<%= i %>][idNumber]" value="<%= r.idNumber || '' %>" <%- aria(`related.${i}.idNumber`) %>><%- err(`related.${i}.idNumber`) %></label>
            <label>Role
              <select name="related[<%= i %>][role]" <%- aria(`related.${i}.role`) %>>
                <option value="">Select…</option>
                <% for (const [ct, roles] of Object.entries(ROLES)) { for (const [k, label] of Object.entries(roles)) { %>
                  <option value="<%= k %>" data-for="<%= ct %>" <%= r.role === k ? 'selected' : '' %>><%= label %></option>
                <% } } %>
              </select><%- err(`related.${i}.role`) %>
            </label>
          </div>
          <div class="grid3">
            <label>Nationality<select name="related[<%= i %>][nationality]"><%- countries.map(([c, n]) => `<option value="${c}" ${(r.nationality || 'ZA') === c ? 'selected' : ''}>${n}</option>`).join('') %></select></label>
            <label>Ownership % <span class="muted small">(if any)</span><input name="related[<%= i %>][ownership]" value="<%= r.ownership || '' %>" inputmode="decimal"></label>
            <label>Public official (PEP)?<select name="related[<%= i %>][pep]"><option value="no">No</option><option value="yes" <%= r.pep === 'yes' ? 'selected' : '' %>>Yes</option></select></label>
          </div>
          <label class="check"><input type="checkbox" name="related[<%= i %>][isEntity]" <%= r.isEntity === 'on' ? 'checked' : '' %>> <span>This owner is a company or trust, not a person</span></label>
        </div>
      <% } %>
    </div>
    <button type="button" class="btn ghost" data-add-related>+ Add another person</button>
  </fieldset>

  <fieldset>
    <legend><span class="step-num" data-num-personal>4</span> <span data-for="individual" <%= t && t !== 'individual' ? 'hidden' : '' %>>Your personal details</span><span data-for="company trust partnership" <%= !t || t === 'individual' ? 'hidden' : '' %>>Your details (the person completing this form)</span></legend>
    <div class="grid2">
      <label>First names<input name="firstName" value="<%= v.firstName || '' %>" autocomplete="given-name" required <%- aria('firstName') %>><%- err('firstName') %></label>
      <label>Surname<input name="lastName" value="<%= v.lastName || '' %>" autocomplete="family-name" required <%- aria('lastName') %>><%- err('lastName') %></label>
    </div>
    <div class="radio-row" role="radiogroup" aria-label="Identity document type">
      <label class="radio"><input type="radio" name="idType" value="sa_id" <%= v.idType !== 'passport' ? 'checked' : '' %> data-toggle-idtype> South African ID</label>
      <label class="radio"><input type="radio" name="idType" value="passport" <%= v.idType === 'passport' ? 'checked' : '' %> data-toggle-idtype> Passport</label>
    </div>
    <div class="grid2">
      <label>ID / passport number<input name="idNumber" value="<%= v.idNumber || '' %>" inputmode="numeric" autocomplete="off" required <%- aria('idNumber') %>><%- err('idNumber') %></label>
      <label data-passport-only <%= v.idType === 'passport' ? '' : 'hidden' %>>Date of birth<input type="date" name="dateOfBirth" value="<%= v.dateOfBirth || '' %>" <%- aria('dateOfBirth') %>><%- err('dateOfBirth') %></label>
    </div>
    <div class="grid3">
      <label>Nationality<select name="nationality" <%- aria('nationality') %>><%- sel('nationality') %></select><%- err('nationality') %></label>
      <label>Mobile number<input name="phone" type="tel" value="<%= v.phone || '' %>" autocomplete="tel" placeholder="+27 82 000 0000" <%- aria('phone') %>><%- err('phone') %></label>
      <label>SARS tax number <span class="muted">(optional)</span><input name="taxNumber" value="<%= v.taxNumber || '' %>" inputmode="numeric" <%- aria('taxNumber') %>><%- err('taxNumber') %></label>
    </div>
    <label>Residential address<input name="addressLine1" value="<%= v.addressLine1 || '' %>" autocomplete="address-line1" required <%- aria('addressLine1') %>><%- err('addressLine1') %></label>
    <label>Suburb / complex <span class="muted">(optional)</span><input name="addressLine2" value="<%= v.addressLine2 || '' %>" autocomplete="address-line2"></label>
    <div class="grid3">
      <label>City<input name="city" value="<%= v.city || '' %>" autocomplete="address-level2" required <%- aria('city') %>><%- err('city') %></label>
      <label>Province<input name="province" value="<%= v.province || '' %>" autocomplete="address-level1"></label>
      <label>Postal code<input name="postalCode" value="<%= v.postalCode || '' %>" autocomplete="postal-code" inputmode="numeric" required <%- aria('postalCode') %>><%- err('postalCode') %></label>
    </div>
    <label>Country of residence<select name="countryOfResidence" <%- aria('countryOfResidence') %>><%- sel('countryOfResidence') %></select><%- err('countryOfResidence') %></label>
    <div class="grid2">
      <label>Occupation<input name="occupation" value="<%= v.occupation || '' %>" required <%- aria('occupation') %>><%- err('occupation') %></label>
      <label>Employer / business name <span class="muted">(optional)</span><input name="employer" value="<%= v.employer || '' %>" autocomplete="organization"></label>
    </div>
  </fieldset>

  <fieldset>
    <legend><span class="step-num">5</span> Income &amp; purpose</legend>
    <div class="grid2">
      <label><span data-for="individual" <%= t && t !== 'individual' ? 'hidden' : '' %>>Main source of income</span><span data-for="company trust partnership" <%= !t || t === 'individual' ? 'hidden' : '' %>>Main source of the entity's funds</span>
        <select name="sourceOfFunds" <%- aria('sourceOfFunds') %>>
          <option value="">Select…</option>
          <% for (const s of sources) { %><option value="<%= s %>" <%= v.sourceOfFunds === s ? 'selected' : '' %>><%= sourceLabels[s] %></option><% } %>
        </select><%- err('sourceOfFunds') %>
      </label>
      <label>Estimated annual income / turnover (ZAR)<input name="expectedValueZar" value="<%= v.expectedValueZar || '' %>" inputmode="numeric" placeholder="e.g. 850 000"></label>
    </div>
    <label>Why do you need our services?<textarea name="purpose" rows="2" required <%- aria('purpose') %>><%= v.purpose || '' %></textarea><%- err('purpose') %></label>
  </fieldset>

  <fieldset>
    <legend><span class="step-num">6</span> Public position</legend>
    <p class="small muted">Are you, or a close family member or associate, a prominent public official (e.g. government minister, judge, senior military officer, head of a state-owned company, senior political party official) in South Africa or abroad?</p>
    <div class="radio-row" <%- aria('pepDeclared') %>>
      <label class="radio"><input type="radio" name="pepDeclared" value="no" <%= v.pepDeclared === 'no' ? 'checked' : '' %> data-toggle-pep> No</label>
      <label class="radio"><input type="radio" name="pepDeclared" value="yes" <%= v.pepDeclared === 'yes' ? 'checked' : '' %> data-toggle-pep> Yes</label>
    </div><%- err('pepDeclared') %>
    <label data-pep-only <%= v.pepDeclared === 'yes' ? '' : 'hidden' %>>Position held and by whom<textarea name="pepDetails" rows="2" <%- aria('pepDetails') %>><%= v.pepDetails || '' %></textarea><%- err('pepDetails') %></label>
  </fieldset>

  <fieldset>
    <legend><span class="step-num">7</span> Documents</legend>
    <p class="small muted">PDF, JPG or PNG, max 5 MB each. Make sure all four corners are visible and the text is readable.<span data-for="" <%= t ? 'hidden' : '' %>> Choose who the application is for (step 1) to see what's needed.</span></p>
    <div class="grid2">
      <% for (const name of Object.keys(DOCUMENTS)) { const types = docTypes(name); const opt = optionalFor(name); %>
        <label class="upload" data-for="<%= types.join(' ') %>" <%= !t || !types.includes(t) ? 'hidden' : '' %>>
          <%= DOCUMENTS[name].label %><% if (opt.includes(t)) { %> <span class="muted">(optional)</span><% } %><% if (DOCUMENTS[name].multiple) { %> <span class="muted small">— you can select several files</span><% } %>
          <%- fileInput(name) %><%- err(name) %>
        </label>
      <% } %>
    </div>
  </fieldset>

  <fieldset>
    <legend><span class="step-num">8</span> Consent &amp; declaration</legend>
    <label class="check"><input type="checkbox" name="consent" <%- aria('consent') %>> <span>I consent to my personal information, and that of the people listed above, being processed and verified with third-party bureaus for FICA purposes, as described in the <a href="/privacy" target="_blank" rel="noopener">privacy notice</a>. I confirm I am authorised to share their information.</span></label><%- err('consent') %>
    <label class="check"><input type="checkbox" name="declaration" <%- aria('declaration') %>> <span>I declare that the information I have provided is true and correct, and I will inform you of any changes.</span></label><%- err('declaration') %>
  </fieldset>

  <div class="actions"><button class="btn primary" type="submit" data-submit>Submit securely</button></div>
</form>
<%- include('../partials/foot') %>
