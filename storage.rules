rules_version = '2';
// Documents are stored encrypted by the portal's server. Browsers only ever upload through
// short-lived signed URLs issued by the server (which bypass these rules); all direct
// Firebase SDK access is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
